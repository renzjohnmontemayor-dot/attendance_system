// ============================================================
// GET RFID UID
// ============================================================

String getUID() {

    String uid = "";


    for (
        byte i = 0;
        i < rfid.uid.size;
        i++
    ) {

        if (
            rfid.uid.uidByte[i]
            <
            0x10
        ) {

            uid += "0";
        }


        uid += String(
            rfid.uid.uidByte[i],
            HEX
        );
    }


    uid.toUpperCase();


    return uid;
}


// ============================================================
// NORMALIZE UID
// ============================================================

String normalizeUID(
    String uid
) {

    String result = "";


    for (
        unsigned int i = 0;
        i < uid.length();
        i++
    ) {

        char c =
            uid.charAt(i);


        if (
            isxdigit(
                (unsigned char)c
            )
        ) {

            result +=
                (char)toupper(
                    (unsigned char)c
                );
        }
    }


    return result;
}


// ============================================================
// URL ENCODE
// ============================================================

String urlEncode(
    String text
) {

    String encoded = "";


    const char* hex =
        "0123456789ABCDEF";


    for (
        unsigned int i = 0;
        i < text.length();
        i++
    ) {

        char c =
            text.charAt(i);


        if (
            isalnum(
                (unsigned char)c
            )
            ||
            c == '-'
            ||
            c == '_'
            ||
            c == '.'
        ) {

            encoded += c;

        }

        else {

            encoded += '%';

            encoded +=
                hex[
                    (c >> 4)
                    &
                    0x0F
                ];

            encoded +=
                hex[
                    c
                    &
                    0x0F
                ];
        }
    }


    return encoded;
}


// ============================================================
// CURRENT TIMESTAMP
//
// Returns UTC timestamp for Supabase.
// Example:
// 2026-08-18T16:30:00Z
//
// Philippines local time is UTC+8.
// ============================================================

String getCurrentTimestamp() {

    time_t now =
        time(nullptr);


    struct tm timeinfo;


    gmtime_r(
        &now,
        &timeinfo
    );


    char buffer[30];


    strftime(
        buffer,
        sizeof(buffer),
        "%Y-%m-%dT%H:%M:%SZ",
        &timeinfo
    );


    return String(
        buffer
    );
}


// ============================================================
// SESSION START
//
// Attendance session:
//
// 6:00 PM -> next day 5:59 PM
//
// Philippines = UTC+8
//
// IMPORTANT:
// This version DOES NOT use timegm().
// ============================================================

String getSessionStartTimestamp() {

    time_t now =
        time(nullptr);


    // --------------------------------------------------------
    // Convert current UTC timestamp to Philippine time
    // --------------------------------------------------------

    time_t philippineNow =
        now + (8 * 3600);


    struct tm ph;


    gmtime_r(
        &philippineNow,
        &ph
    );


    // --------------------------------------------------------
    // Current Philippine hour
    // --------------------------------------------------------

    int currentHour =
        ph.tm_hour;


    // --------------------------------------------------------
    // Session starts at 6:00 PM
    // --------------------------------------------------------

    ph.tm_hour = 18;
    ph.tm_min = 0;
    ph.tm_sec = 0;


    // --------------------------------------------------------
    // If current Philippine time is before 6 PM,
    // the session started yesterday.
    // --------------------------------------------------------

    if (
        currentHour < 18
    ) {

        ph.tm_mday--;

        // ----------------------------------------------------
        // Handle month/year boundary safely.
        //
        // Instead of depending on mktime(), we calculate
        // the previous calendar date manually.
        // ----------------------------------------------------

        if (
            ph.tm_mday < 1
        ) {

            ph.tm_mon--;


            if (
                ph.tm_mon < 0
            ) {

                ph.tm_mon = 11;

                ph.tm_year--;
            }


            int year =
                ph.tm_year + 1900;


            int month =
                ph.tm_mon + 1;


            int daysInMonth = 31;


            if (
                month == 4
                ||
                month == 6
                ||
                month == 9
                ||
                month == 11
            ) {

                daysInMonth = 30;

            }

            else if (
                month == 2
            ) {

                bool leap =
                    (
                        year % 4 == 0
                        &&
                        (
                            year % 100 != 0
                            ||
                            year % 400 == 0
                        )
                    );

                daysInMonth =
                    leap ? 29 : 28;
            }


            ph.tm_mday =
                daysInMonth;
        }
    }


    // --------------------------------------------------------
    // Convert Philippine calendar date to Unix timestamp.
    //
    // We first create a "pseudo UTC" timestamp representing
    // the Philippine date/time as if it were UTC.
    // Then subtract 8 hours to get the real UTC timestamp.
    // --------------------------------------------------------

    int year =
        ph.tm_year + 1900;


    int month =
        ph.tm_mon + 1;


    int day =
        ph.tm_mday;


    time_t pseudoUTC =
        dateTimeToUnix(
            year,
            month,
            day,
            18,
            0,
            0
        );


    time_t sessionUTC =
        pseudoUTC
        -
        (8 * 3600);


    // --------------------------------------------------------
    // Format UTC timestamp
    // --------------------------------------------------------

    struct tm sessionTM;


    gmtime_r(
        &sessionUTC,
        &sessionTM
    );


    char buffer[30];


    strftime(
        buffer,
        sizeof(buffer),
        "%Y-%m-%dT%H:%M:%SZ",
        &sessionTM
    );


    Serial.print(
        "Session start UTC: "
    );

    Serial.println(
        buffer
    );


    return String(
        buffer
    );
}


// ============================================================
// FIND STUDENT BY RFID
// ============================================================

bool findStudent(
    String uid,
    String &studentUUID,
    String &studentName,
    String &studentNumber,
    String &course
) {

    WiFiClientSecure client;

    client.setInsecure();


    HTTPClient http;


    String url =
        String(SUPABASE_URL)
        +
        "/rest/v1/students"
        +
        "?rfid_uid=eq."
        +
        urlEncode(uid)
        +
        "&select=id,student_id_number,full_name,course_section"
        +
        "&limit=1";


    Serial.println(
        "Student lookup:"
    );

    Serial.println(
        url
    );


    if (
        !http.begin(
            client,
            url
        )
    ) {

        Serial.println(
            "HTTP begin failed"
        );

        return false;
    }


    http.addHeader(
        "apikey",
        SUPABASE_KEY
    );

    http.addHeader(
        "Authorization",
        String("Bearer ")
        +
        SUPABASE_KEY
    );


    http.setTimeout(
        5000
    );


    int code =
        http.GET();


    if (
        code != 200
    ) {

        Serial.print(
            "Student GET error: "
        );

        Serial.println(
            code
        );

        http.end();

        return false;
    }


    String response =
        http.getString();


    http.end();


    Serial.print(
        "Student response: "
    );

    Serial.println(
        response
    );


    DynamicJsonDocument doc(
        2048
    );


    DeserializationError error =
        deserializeJson(
            doc,
            response
        );


    if (
        error
    ) {

        Serial.print(
            "JSON error: "
        );

        Serial.println(
            error.c_str()
        );

        return false;
    }


    JsonArray array =
        doc.as<JsonArray>();


    if (
        array.size() == 0
    ) {

        return false;
    }


    JsonObject student =
        array[0];


    studentUUID =
        student["id"]
        |
        "";


    studentName =
        student["full_name"]
        |
        "";


    studentNumber =
        student["student_id_number"]
        |
        "";


    course =
        student["course_section"]
        |
        "";


    return (
        studentUUID.length()
        >
        0
    );
}


// ============================================================
// CHECK SESSION ATTENDANCE
// ============================================================

bool getAttendanceForStudent(
    String studentUUID,
    bool &hasTimeIn,
    bool &hasTimeOut
) {

    hasTimeIn = false;

    hasTimeOut = false;


    WiFiClientSecure client;

    client.setInsecure();


    HTTPClient http;


    String sessionStart =
        getSessionStartTimestamp();


    String url =
        String(SUPABASE_URL)
        +
        "/rest/v1/attendance_records"
        +
        "?student_id=eq."
        +
        urlEncode(studentUUID)
        +
        "&timestamp=gte."
        +
        urlEncode(sessionStart)
        +
        "&select=status,timestamp"
        +
        "&order=timestamp.asc";


    Serial.println(
        "Attendance lookup:"
    );

    Serial.println(
        url
    );


    if (
        !http.begin(
            client,
            url
        )
    ) {

        Serial.println(
            "Attendance HTTP begin failed"
        );

        return false;
    }


    http.addHeader(
        "apikey",
        SUPABASE_KEY
    );

    http.addHeader(
        "Authorization",
        String("Bearer ")
        +
        SUPABASE_KEY
    );


    http.setTimeout(
        5000
    );


    int code =
        http.GET();


    if (
        code != 200
    ) {

        Serial.print(
            "Attendance GET error: "
        );

        Serial.println(
            code
        );

        http.end();

        return false;
    }


    String response =
        http.getString();


    http.end();


    Serial.print(
        "Attendance response: "
    );

    Serial.println(
        response
    );


    DynamicJsonDocument doc(
        4096
    );


    DeserializationError error =
        deserializeJson(
            doc,
            response
        );


    if (
        error
    ) {

        Serial.print(
            "Attendance JSON error: "
        );

        Serial.println(
            error.c_str()
        );

        return false;
    }


    JsonArray rows =
        doc.as<JsonArray>();


    for (
        JsonObject row :
        rows
    ) {

        String status =
            row["status"]
            |
            "";


        status.trim();

        status.toLowerCase();


        if (
            status ==
            "present"
        ) {

            hasTimeIn = true;
        }


        if (
            status ==
            "time out"
            ||
            status ==
            "timeout"
        ) {

            hasTimeOut = true;
        }
    }


    return true;
}


