// ============================================================
// DATE TO UNIX TIME
//
// ESP32-compatible replacement for timegm()
//
// Converts a UTC calendar date/time into Unix timestamp.
// ============================================================

time_t dateTimeToUnix(
    int year,
    int month,
    int day,
    int hour,
    int minute,
    int second
) {

    // --------------------------------------------------------
    // Normalize January/February
    // --------------------------------------------------------

    if (month <= 2) {
        year--;
        month += 12;
    }


    // --------------------------------------------------------
    // Days from 1970-01-01
    // --------------------------------------------------------

    long days =
        365L * (year - 1970)
        +
        (year - 1969) / 4
        -
        (year - 1901) / 100
        +
        (year - 1901) / 400;


    static const int daysBeforeMonth[] = {
        0,   // January
        31,  // February
        59,  // March
        90,  // April
        120, // May
        151, // June
        181, // July
        212, // August
        243, // September
        273, // October
        304, // November
        334  // December
    };


    // --------------------------------------------------------
    // Since the month was converted above:
    //
    // month 3 = March
    // month 14 = February
    //
    // Use normal month calculation.
    // --------------------------------------------------------

    int normalYear = year;
    int normalMonth = month;

    if (normalMonth > 12) {
        normalMonth -= 12;
        normalYear++;
    }


    int monthIndex =
        normalMonth - 1;


    long dayOfYear =
        daysBeforeMonth[monthIndex];


    // Leap year adjustment
    if (
        normalMonth > 2
        &&
        (
            (normalYear % 4 == 0)
            &&
            (
                normalYear % 100 != 0
                ||
                normalYear % 400 == 0
            )
        )
    ) {
        dayOfYear++;
    }


    days +=
        dayOfYear
        +
        (day - 1);


    time_t result =
        (time_t)days * 86400;


    result +=
        (time_t)hour * 3600;

    result +=
        (time_t)minute * 60;

    result +=
        second;


    return result;
}


