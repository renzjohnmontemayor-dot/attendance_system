) {

    uid =
        normalizeUID(
            uid
        );


    // --------------------------------------------------------
    // LCD VERIFYING
    // --------------------------------------------------------

    lcd.clear();

    lcd.setCursor(
        0,
        0
    );

    lcd.print(
        "VERIFYING..."
    );

    lcd.setCursor(
        0,
        1
    );

    lcd.print(
        uid.substring(
            0,
            16
        )
    );


    // --------------------------------------------------------
    // STUDENT VARIABLES
    // --------------------------------------------------------

    String studentUUID;

    String studentName;

    String studentNumber;

    String course;


    // --------------------------------------------------------
    // FIND STUDENT
    // --------------------------------------------------------

    bool found =
        findStudent(
            uid,
            studentUUID,
            studentName,
            studentNumber,
            course
        );


    // ========================================================
    // NOT REGISTERED
    // ========================================================

    if (
        !found
    ) {

        Serial.println(
            "NOT REGISTERED"
        );


        insertUnregisteredScan(
            uid
        );


        lcd.clear();

        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "NOT REGISTERED"
        );

        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            uid.substring(
                0,
                16
            )
        );


        digitalWrite(
            RED_LED,
            HIGH
        );


        tone(
            BUZZER_PIN,
            700,
            500
        );


        delay(1800);


        digitalWrite(
            RED_LED,
            LOW
        );


        showReady();

        return;
    }


    // ========================================================
    // STUDENT FOUND
    // ========================================================

    Serial.println(
        "Student found:"
    );

    Serial.println(
        studentName
    );


    // --------------------------------------------------------
    // CHECK ATTENDANCE
    // --------------------------------------------------------

    bool hasTimeIn = false;

    bool hasTimeOut = false;


    bool attendanceOK =
        getAttendanceForStudent(
            studentUUID,
            hasTimeIn,
            hasTimeOut
        );


    // ========================================================
    // SERVER ERROR
    // ========================================================

    if (
        !attendanceOK
    ) {

        lcd.clear();

        lcd.setCursor(
            0,
            0
        );

        lcd.print(
            "SERVER ERROR"
        );

        lcd.setCursor(
            0,
            1
        );

        lcd.print(
            "Try again"
        );


        digitalWrite(
            RED_LED,
            HIGH
        );


        tone(
            BUZZER_PIN,
            500,
            700
        );


        delay(1500);


        digitalWrite(
            RED_LED,
            LOW
        );


        showReady();

        return;
    }


    // ========================================================
    // TIME IN
    // ========================================================

    if (
        !hasTimeIn
    ) {

        Serial.println(
            "TIME IN"
        );


        bool saved =
            insertAttendance(
                studentUUID,
                uid,
                "Present"
            );


        if (
            saved
        ) {

            lcd.clear();

            lcd.setCursor(
                0,
                0
            );

            lcd.print(
                "TIME IN"
            );

            lcd.setCursor(
                0,
                1
            );

            lcd.print(
                studentName.substring(
                    0,
                    16
                )
            );


            digitalWrite(
                GREEN_LED,
                HIGH
            );


            tone(
                BUZZER_PIN,
                1800,
                180
            );


            delay(100);


            tone(
                BUZZER_PIN,
                2200,
                180
            );


            delay(1800);


            digitalWrite(
                GREEN_LED,
                LOW
            );

        }

        else {

            lcd.clear();

            lcd.setCursor(
                0,
                0
            );

            lcd.print(
                "SAVE FAILED"
            );

            lcd.setCursor(
                0,
                1
            );

            lcd.print(
                "Try again"
            );


            digitalWrite(
                RED_LED,
                HIGH
            );


            tone(
                BUZZER_PIN,
                500,
                600
            );


            delay(1500);


            digitalWrite(
                RED_LED,
                LOW
            );
        }


        showReady();

        return;
    }


    // ========================================================
    // TIME OUT
    // ========================================================

    if (
        !hasTimeOut
    ) {

        Serial.println(
            "TIME OUT"
        );


        bool saved =
            insertAttendance(
                studentUUID,
                uid,
                "Time Out"
            );


        if (
            saved
        ) {

            lcd.clear();

            lcd.setCursor(
                0,
                0
            );

            lcd.print(
                "TIME OUT"
            );

            lcd.setCursor(
                0,
                1
            );

            lcd.print(
                studentName.substring(
                    0,
                    16
                )
            );


            digitalWrite(
                GREEN_LED,
                HIGH
            );


            tone(
                BUZZER_PIN,
                1800,
                180
            );


            delay(100);


            tone(
                BUZZER_PIN,
                1200,
                180
            );


            delay(1800);


            digitalWrite(
                GREEN_LED,
                LOW
            );

        }

        else {

            lcd.clear();

            lcd.setCursor(
                0,
                0
            );

            lcd.print(
                "SAVE FAILED"
            );

            lcd.setCursor(
                0,
                1
            );

            lcd.print(
                "Try again"
            );


            digitalWrite(
                RED_LED,
                HIGH
            );


            tone(
                BUZZER_PIN,
                500,
                600
            );


            delay(1500);


            digitalWrite(
                RED_LED,
                LOW
            );
        }


        showReady();

        return;
    }


    // ========================================================
    // ALREADY COMPLETE
    // ========================================================

    Serial.println(
        "ATTENDANCE COMPLETE"
    );


    lcd.clear();

    lcd.setCursor(
        0,
        0
    );

    lcd.print(
        "ALREADY DONE"
    );

    lcd.setCursor(
        0,
        1
    );

    lcd.print(
        studentName.substring(
            0,
            16
        )
    );


    tone(
        BUZZER_PIN,
        900,
        700
    );


    delay(1600);


    showReady();
}
