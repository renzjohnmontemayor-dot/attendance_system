bool insertAttendance(
    String studentUUID,
    String uid,
    String status
) {

    WiFiClientSecure client;

    client.setInsecure();


    HTTPClient http;


    String url =
        String(SUPABASE_URL)
        +
        "/rest/v1/attendance_records";


    if (
        !http.begin(
            client,
            url
        )
    ) {

        Serial.println(
            "Attendance POST begin failed"
        );

        return false;
    }


    http.addHeader(
        "apikey",
        SUPABASE_KEY
    );

    http.addHeader(
        "Authorization",
        String("Bearer ")
        +
        SUPABASE_KEY
    );

    http.addHeader(
        "Content-Type",
        "application/json"
    );

    http.addHeader(
        "Prefer",
        "return=minimal"
    );


    DynamicJsonDocument doc(
        1024
    );


    doc["student_id"] =
        studentUUID;


    doc["scanned_rfid"] =
        uid;


    doc["status"] =
        status;


    doc["timestamp"] =
        getCurrentTimestamp();


    String body;


    serializeJson(
        doc,
        body
    );


    Serial.print(
        "Attendance body: "
    );

    Serial.println(
        body
    );


    int code =
        http.POST(
            body
        );


    Serial.print(
        "Attendance POST: "
    );

    Serial.println(
        code
    );


    if (
        code < 200
        ||
        code >= 300
    ) {

        Serial.print(
            "POST response: "
        );

        Serial.println(
            http.getString()
        );
    }


    http.end();


    return (
        code >= 200
        &&
        code < 300
    );
}


